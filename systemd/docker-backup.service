[Unit]
Description=Docker volume backup to NAS
Documentation=file:///usr/local/lib/docker-backup
After=network-online.target docker.service
Wants=network-online.target
RequiresMountsFor=/mnt/backup
OnFailure=docker-backup-notify.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/docker-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h

[Install]
WantedBy=multi-user.target
