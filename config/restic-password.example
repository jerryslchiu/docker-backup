# EXAMPLE ONLY. Do not commit a real password.
#
# Copy to /root/.restic-password and replace the last line with a long random
# string, or let install.sh generate one:
#   openssl rand -base64 32 | sudo tee /root/.restic-password
#   sudo chmod 600 /root/.restic-password
#
# The live file must contain only the password (one line, no quotes, no comments).
# Without this password, existing snapshots cannot be restored.

replace-me-with-a-long-random-string
