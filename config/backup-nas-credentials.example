# EXAMPLE ONLY. Do not commit real NAS credentials.
#
# Copy to /root/.backup-nas-credentials and chmod 600.
# The live CIFS credentials file must contain only these keys (no comments):
#
#   username=backup
#   password=change-me
#   domain=WORKGROUP
#
# domain is optional. NFS mounts do not use this file.

username=backup
password=change-me
