# Copy to /etc/docker-backup/backup.env and edit.
# Do not commit a filled-in copy.

# NAS mount point (CIFS or NFS). Backup fails if this is not mounted.
BACKUP_MOUNT=/mnt/backup
RESTIC_REPOSITORY=/mnt/backup/restic-docker
RESTIC_PASSWORD_FILE=/root/.restic-password
RESTIC_CACHE_DIR=/var/cache/restic

# Named Docker volumes. Set BACKUP_ALL_VOLUMES=0 and list names to limit scope.
BACKUP_VOLUME_ROOT=/var/lib/docker/volumes
BACKUP_ALL_VOLUMES=1
BACKUP_VOLUME_NAMES=
# Space- or comma-separated volume names to skip (e.g. build caches).
BACKUP_VOLUME_EXCLUDE=

# Extra host paths: bind-mount data and compose projects (yaml + .env).
# Space- or comma-separated. Globs are expanded by the backup script.
BACKUP_BIND_PATHS=
BACKUP_COMPOSE_PATHS=/opt/stacks

# App-aware dumps written here, then included in the restic snapshot.
BACKUP_DUMPS_DIR=/var/backups/docker-dumps
DUMPS_CONFIG=/etc/docker-backup/dumps.yaml

# Containers with this label are stopped for the snapshot, then started again.
FREEZE_LABEL=backup.freeze=true

# Warn about running postgres/mysql/mongo/redis containers with no dump mapping.
BACKUP_WARN_UNMAPPED_DBS=1

# Retention after each successful backup.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# Optional Healthchecks.io ping URL (https://hc-ping.com/<uuid>).
# /start is called at the beginning, the URL on success, /fail on error.
HEALTHCHECKS_URL=
